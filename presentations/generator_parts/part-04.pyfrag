    bridge(prs,D,M,'Giornata 3 — Vulnerability Assessment + Web Mapping','Se uno scanner ci dice “HIGH”, cosa dobbiamo vedere prima di scriverlo in un report?','DAY 03')
    # backup
    cards(prs,D,M,'TCP e TLS: cosa ci interessa davvero',[
        {'title':'TCP','body':['connessione e porta','stato open / closed / filtered']},
        {'title':'TLS','body':['certificato e cifratura','hostname e validità del certificato'],'color':BLUE},
        {'title':'NOI CERCHIAMO','body':['evidenze utili al modello del sistema','non teoria fine a se stessa'],'color':AMBER}],
        'Approfondiamo solo quando serve a interpretare un output',section='approfondimento',backup=True)
    cards(prs,D,M,'Porte comuni: memoria utile, non regola assoluta',[
        {'title':'22','body':['spesso SSH']},{'title':'80 / 443','body':['spesso HTTP / HTTPS'],'color':BLUE},{'title':'53','body':['spesso DNS'],'color':AMBER},{'title':'3306 / 5432','body':['database comuni','non assumiamo il prodotto solo dalla porta'],'color':VIOLET}],
        'La porta suggerisce; il servizio si verifica',section='approfondimento',backup=True)
    matrix(prs,D,M,'Mini cheat sheet HTTP',['Elemento','Domanda che ci facciamo'],[
        ['Host','quale virtual host stiamo raggiungendo?'],['Path / query','quale risorsa e quale input controlliamo?'],['Cookie / Authorization','come viene riconosciuta l’identità?'],['Status / Location','che decisione ha preso il server?'],['Body / headers','quali dati e indizi ci restituisce?']],
        'Non dobbiamo ricordare tutto: dobbiamo sapere dove guardare.',section='approfondimento',backup=True)
    return prs


def build_day3():
    prs=Presentation();set_wide(prs);D='DAY 03';M='04 + 05'
    cover(prs,D,'Dall’alert alla superficie applicativa','Impariamo a validare ciò che uno scanner suggerisce e a mappare una web app prima di testarla.',M,['scansioniamo','validiamo','osserviamo il traffico','mappiamo l’app'])
    journey_slide(prs,D,M,[('VA','cosa segnala il tool'),('validation','cosa regge davvero'),('proxy','cosa fa l’app'),('mapping','dove vale testare')],['validation table','web map','next-test list'])
    statement(prs,D,M,'Uno scanner produce ipotesi ad alta velocità.','Un Vulnerability Assessment trasforma quelle ipotesi in conclusioni supportate da evidenze.',accent=TEAL)
    process(prs,D,M,'Da alert a finding',['alert','evidence','prerequisiti','verifica','contesto','conclusione'],'La severity del tool è solo un punto di partenza')
    cards(prs,D,M,'CVE, CWE e CVSS: usiamoli per il motivo giusto',[
        {'title':'CVE','body':['identifica una vulnerabilità nota','serve una corrispondenza reale col target']},
        {'title':'CWE','body':['descrive una classe di debolezza','aiuta a capire la causa'],'color':BLUE},
        {'title':'CVSS','body':['stima severity tecnica','non conosce il business del cliente'],'color':AMBER}],
        'Sigle utili, ma non sostituiscono la validazione')
    terminal(prs,D,M,'Lo scanner vede un banner e salta a una conclusione','''[HIGH] Outdated Web Server Version
Target: shop.umbramarket.lab
Evidence: Server: nginx/1.24.0
Claim: Remote Code Execution possible
Confidence: High''',[
        ('EVIDENZA','solo il banner',TEAL),('MANCA','build reale + prerequisiti',BLUE),('DECISIONE','non è ancora un finding RCE',AMBER)],'L’overclaim è uno degli errori più facili da commettere')
    cards(prs,D,M,'False positive e false negative',[
        {'title':'FALSE POSITIVE','body':['il tool segnala','il problema non è presente'],'color':RED},
        {'title':'FALSE NEGATIVE','body':['il problema esiste','il tool non lo vede'],'color':AMBER},
        {'title':'CONSEGUENZA','body':['serve validazione umana','e serve anche testing manuale'],'color':GREEN}],
        'Automazione e ragionamento si completano')
    matrix(prs,D,M,'Una validation table che possiamo difendere',['Alert','Evidence','Prerequisites','Status','Next action'],[
        ['old nginx','banner only','exact build?','unverified','manual verify'],
        ['missing CSP','header absent','impact chain?','confirmed config','contextualize'],
        ['admin exposed','external link','scope?','out of scope','do not test']],
        'Lo status deve riflettere quello che sappiamo oggi')
    big_question(prs,D,M,'E quando passiamo alla web app, da dove iniziamo?','Non dalla lista OWASP. Prima dobbiamo capire cosa fa l’app.','Mappiamo funzioni, utenti, oggetti e transizioni.',section='web mapping')
    process(prs,D,M,'Il proxy ci mette in mezzo',['browser','proxy','request','server','response','replay'],'Possiamo osservare e cambiare una variabile per volta',section='web mapping')
    cards(prs,D,M,'In ogni funzione cerchiamo quattro cose',[
        {'title':'AZIONE','body':['visualizza, crea, modifica, elimina','cosa cambia davvero?']},
        {'title':'OGGETTO','body':['ordine, profilo, ticket, file','come viene identificato?'],'color':BLUE},
        {'title':'IDENTITÀ','body':['anonimo, Alice, Bob, admin','chi sta facendo la richiesta?'],'color':AMBER},
        {'title':'INPUT','body':['path, query, JSON, header','cosa possiamo controllare?'],'color':VIOLET}],
        'Questa mappa genera naturalmente i test')
    terminal(prs,D,M,'Una funzione, vista dal traffico','''POST /api/cart/items HTTP/1.1
Host: shop.umbramarket.lab
Cookie: session=demo-alice
Content-Type: application/json

{"productId":42,"quantity":2}''',[
        ('AZIONE','aggiunge un prodotto',TEAL),('INPUT','productId + quantity',BLUE),('DOMANDE','prezzo? limiti? ownership?',AMBER)],'Non serve attaccare subito: basta saper formulare le domande giuste')
    matrix(prs,D,M,'Application Attack Surface',['Funzione','Endpoint','Oggetto','Auth','Input chiave','Next test'],[
        ['catalog','GET /api/products','product','public','category','input handling'],
        ['cart','POST /api/cart/items','cart','Alice','productId, qty','server-side trust'],
        ['order','GET /api/orders/1001','order','Alice','orderId','authorization']],
        'Questa tabella diventa la base delle giornate 4 e 5')
    lab_handoff(prs,D,M,'Laboratorio — Scanner vs Human + Map Before You Attack','Prima riceviamo un report scanner rumoroso. Poi osserviamo traffico reale della web app.',[
        'validiamo gli alert','separiamo status e severity','mappiamo funzioni e oggetti','proponiamo i test successivi'],
        'Validation Table + Application Attack Surface Map')
    big_question(prs,D,M,'Quando possiamo scrivere “vulnerabile”?','Non quando il tool lo dice. Quando la nostra evidenza sostiene esattamente quella conclusione.','Qual è l’affermazione più forte che possiamo difendere?',section='debrief')
    takeaways(prs,D,M,['trattare scanner output come input, non verità','distinguere CVE, CWE, CVSS e rischio business','usare un proxy per capire il comportamento dell’app','mappare funzioni, oggetti, identità e input prima del testing'])
    bridge(prs,D,M,'Giornata 4 — Input Handling & Injection','Quando un input arriva al server, chi lo interpreta e come possiamo accorgerci che cambia il comportamento?','DAY 04')
    # backup
    cards(prs,D,M,'Severity tecnica e priorità business non sono la stessa cosa',[
        {'title':'TECNICA','body':['exploitability','impact potenziale','scope tecnico']},
        {'title':'BUSINESS','body':['dato coinvolto','processo critico','utenti e volume'],'color':BLUE},
        {'title':'PRIORITÀ','body':['unisce entrambe','e considera compensating controls'],'color':AMBER}],
        'Il report deve spiegare il perché della priorità',section='approfondimento',backup=True)
    cards(prs,D,M,'Burp / ZAP: cosa ci interessa in aula',[
        {'title':'PROXY','body':['vedere request e response','intercettare quando serve']},
        {'title':'REPLAY','body':['ripetere una request','cambiare una variabile'],'color':BLUE},
        {'title':'HISTORY','body':['ricostruire il flusso','mappare endpoint e parametri'],'color':AMBER}],
        'Le feature servono al metodo, non viceversa',section='approfondimento',backup=True)
    process(prs,D,M,'Decision tree per validare un alert',['cosa dice?','quale evidence?','quali prerequisiti?','possiamo verificare?','impatto reale?','finding / nota'],'Ci fermiamo appena sappiamo classificare l’alert con onestà.',section='approfondimento',backup=True)
    return prs


def build_day4():
    prs=Presentation();set_wide(prs);D='DAY 04';M='06'
    cover(prs,D,'Input Handling & Injection','Partiamo dal comportamento dell’applicazione, non dai payload. Cerchiamo segnali, conferme e una prova minima.',M,['seguiamo l’input','capire il contesto','testiamo una variabile','confermiamo'])
    journey_slide(prs,D,M,[('input','da dove entra'),('context','chi lo interpreta'),('baseline','cosa succede normalmente'),('evidence','cosa cambia davvero')],['input sheet','evidence chain','finding con remediation'])
    big_question(prs,D,M,'Quando un parametro arriva al server, dove finisce?','La stessa stringa può essere innocua in un contesto e pericolosa in un altro.','Prima capiamo il contesto. Poi scegliamo il test.')
    cards(prs,D,M,'Un input può entrare da molti punti',[
        {'title':'URL','body':['query string','path parameter']},
        {'title':'BODY','body':['form','JSON / XML'],'color':BLUE},
        {'title':'HEADER / COOKIE','body':['metadata controllabile','session-related input'],'color':AMBER},
        {'title':'FILE','body':['nome, tipo, contenuto','pipeline di parsing'],'color':VIOLET}],
        'Ogni punto di ingresso attraversa una trust boundary')
    statement(prs,D,M,'La domanda non è «quale payload provo?».','La domanda è: quale componente interpreterà questo dato — SQL, HTML/JS, shell, filesystem, template, parser?',accent=BLUE)
    cards(prs,D,M,'Famiglie di injection: stesso principio, contesti diversi',[
        {'title':'SQL','body':['input entra nella costruzione della query','effetto: logica dati alterata']},
        {'title':'HTML / JS','body':['input viene reso nel browser','effetto: interpretazione lato client'],'color':BLUE},
        {'title':'COMMAND','body':['input entra in un comando','effetto: comportamento del sistema'],'color':AMBER},
        {'title':'PATH','body':['input influenza un percorso','effetto: risorsa inattesa'],'color':VIOLET}],
        'Capire il sink vale più che memorizzare stringhe')
    process(prs,D,M,'Il nostro metodo operativo',['scegli input','baseline','test minimo','osserva differenza','ripeti','concludi'],'Una variabile per volta')
    terminal(prs,D,M,'Baseline: comportamento normale','''GET /api/products/search?q=desk HTTP/1.1
Host: shop.umbramarket.lab

HTTP/1.1 200 OK
Content-Type: application/json

{"count":2,"items":[...]}''',[
        ('BASELINE','200 + 2 risultati',TEAL),('COSA CAMBIAMO','solo q',BLUE),('COSA OSSERVIAMO','status, body, count, timing',AMBER)],'Prima di cercare anomalie dobbiamo conoscere il comportamento normale')
    terminal(prs,D,M,'Un input anomalo cambia il comportamento','''GET /api/products/search?q=desk%27 HTTP/1.1

HTTP/1.1 500 Internal Server Error
Content-Type: application/json

{"error":"search backend rejected query","reference":"ERR-DB-17"}''',[
        ('FATTO','un carattere cambia la response',TEAL),('NON BASTA','500 ≠ SQL injection',RED),('IPOTESI','input gestito male lato backend',BLUE)],'Il segnale serve a scegliere il prossimo test, non a scrivere già il finding')
    cards(prs,D,M,'Quali segnali possiamo usare?',[
        {'title':'DIFFERENZA LOGICA','body':['numero risultati','contenuto inatteso']},
        {'title':'ERRORE','body':['messaggio diverso','stack / reference'],'color':BLUE},
        {'title':'TIMING','body':['latenza coerente e ripetibile','attenzione al rumore'],'color':AMBER},
        {'title':'CONTESTO CLIENT','body':['rendering / DOM','encoding e sink'],'color':VIOLET}],
        'Un singolo segnale debole raramente basta')
    compare(prs,D,M,'Detection e impact','DETECTION',[
        'cerchiamo un segnale coerente','costruiamo una conferma minima','spesso basta per stabilire la causa probabile'],
        'IMPACT',[
        'dimostriamo una conseguenza concreta','non serve sempre arrivare al massimo impatto','lo scope e la stop condition decidono fin dove andare'],
        'La prova deve essere proporzionata al rischio.')
    cards(prs,D,M,'Remediation: correggiamo la causa, non il sintomo',[
